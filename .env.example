# ====================================================
# CONFIGURAÇÕES DO MOTOR DE BLOG & SEO
# Copie este arquivo para .env e preencha seus dados
# ou configure diretamente pela aba 'Ajustes' no Dashboard
# ====================================================

# Chave de API do Google Gemini (gratuita em https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="sua_chave_gemini_aqui"

# Dados do WordPress com permissão de publicação REST API
WP_URL="https://seublog.com.br/blog/"
WP_USER="seu_usuario_wordpress"
WP_APP_PASSWORD="sua_senha_de_aplicativo_wp"

# Caminho para o arquivo de credenciais da Conta de Serviço do Google Search Console
GSC_CREDENTIALS_JSON="credenciais_gsc.json"
